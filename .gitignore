.venv/
.uv/
.env
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
# Generated by hatch-vcs's build hook (pyproject.toml). Never track this --
# it's regenerated by any real build, and bootstrap.py deliberately never
# lets that happen for an end-user launch (see its docstring); the version
# shipped in a release archive is a plain file placed there by the release
# workflow, not tracked in git at all.
/src/sorter/_version.py

# Runtime state. The data root normally lives outside the repo (see README);
# `data/` only appears here for portable installs and legacy checkouts.
# Root-anchored: `src/sorter/data/` is a tracked subpackage (persistence
# layer), not a runtime data folder, and an unanchored pattern would swallow
# it.
/data/
# Marker that pins the data root to <app>/data — a local choice, never committed.
portable.txt
.coverage

# `mkdocs build`'s output. The published site is built in CI and pushed to the
# gh-pages branch by mike; a local build is a preview.
/site/

# `.claude/skills/` is tracked, so the rest of `.claude/` has to be named:
# worktrees are per-machine checkouts, and settings.local.json is personal.
/.claude/worktrees/
/.claude/settings.local.json
